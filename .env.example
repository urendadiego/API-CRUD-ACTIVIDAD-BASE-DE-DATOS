PORT=3000

# Base compartida del grupo (Supabase -> Connect -> URI -> Session pooler). Pedirla por privado.
DATABASE_URL=postgresql://postgres.xxxx:CONTRASEÑA@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Alternativa: PostgreSQL local (se usan solo si DATABASE_URL no está definida)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=su_contraseña
DB_NAME=eventos
